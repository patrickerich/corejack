        <mxCell id="t8_cpu_data" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle" value="CPU data&#xa;(fabric + planned mem port)" vertex="1">
