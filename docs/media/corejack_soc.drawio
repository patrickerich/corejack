        <mxCell id="note_cr" parent="cr3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;spacingTop=4" value="Each socket adapter wraps an upstream core (e.g. ibex_top, cv32e40p_core, serv_top, picorv32, wallypipelinedcore) and presents a uniform OBI-like instr/data interface plus alert/sleep signals. SERV, PicoRV32, and CVW have native single-port or AHB-Lite buses; their adapters bridge those into the same OBI-like socket boundary.&#xa;The selector picks one adapter at elaboration time via the CoreType parameter; only that branch is generated by the synthesis tool.&#xa;CVA6 (CoreType = CORE_CVA6) does NOT enter this region: it is wired directly as a native-AXI initiator in soc_top via corejack_cva6_axi_adapter (see Tab 1). The CVA6 branch here only exists to fatal in sim if the split OBI path is mistakenly selected for CVA6." vertex="1">
          <mxGeometry height="100" width="1140" x="160" y="870" as="geometry" />
        </mxCell>
        <mxCell id="ee1" edge="1" parent="cr3" source="g_ibex" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.0385;fontSize=10" target="mux">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ee2" edge="1" parent="cr3" source="g_e40p" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.1538;fontSize=10" target="mux">
