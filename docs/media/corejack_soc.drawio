        <mxCell id="t8_apb_clint" parent="t8_apb_subsys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;dashed=1" value="clint (APB wrap)&#xa;planned" vertex="1">
