              <mxPoint x="610" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="de11" edge="1" parent="1" source="d_rstg" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10" target="d_core" value="core_rst_ni">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;spacingTop=4" value="Notes:&#xa;- DM register window comes back from the AXI demux port[2] (DEBUG) via soc_axi_to_dm.&#xa;- DM SBA goes back into the AXI fabric as the third initiator (AXI[2]) for memory loads.&#xa;- ndmreset_ack is generated in soc_top after rstgen brings core_init_ni high again.&#xa;- debug_req and ndmreset are routed around the DM slave/SBA blocks via the left channel (x=610-620) so they don&#39;t cross other blocks." vertex="1">
          <mxGeometry height="100" width="1300" x="60" y="720" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
