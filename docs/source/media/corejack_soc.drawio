                </mxCell>
                <mxCell id="lbl_clint_top" value="0x02010000" style="text;html=1;align=right;verticalAlign=middle;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="40" y="810" width="80" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="lbl_clint_bot" value="0x02000000" style="text;html=1;align=right;verticalAlign=middle;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="40" y="870" width="80" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="c_clint" value="CLINT (ClintBaseAddr=0x02000000, ClintSize=0x10000 = 64 KiB)&#xa;Machine timer (mtime/mtimecmp) and IPI; reachable via axi_xbar port[3] -&gt; soc_axi_to_reg -&gt; clint. RTC ticks from a divided SoC clock (12.5 MHz at the 25 MHz baseline)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="240" y="820" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r_dbg" value="DEBUG (window)&#xa;DebugBaseAddr+0x1000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="120" y="980" width="80" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c_ram" value="RAM (RamBaseAddr=0x80000000, RamWords=262144 -&gt; 1 MiB)&#xa;Boot vector is core-dependent: Ibex / CV32E40S boot at RamBaseAddr; CV32E40P/X, CVA6, SERV, PicoRV32 boot at RamBaseAddr+0x80; CVW uses its upstream config&#39;s reset address.&#xa;Banked 4x 64-bit (full interleaving by 64-bit word index)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="240" y="380" width="540" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c_uart" value="UART (UartBaseAddr=0x10000000, 4 KiB region)&#xa;APB; 115200 baud at 25 MHz core clock; reachable via axi_xbar port[1] -&gt; soc_axi_to_apb -&gt; apb_uart_wrap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="240" y="640" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="c_dbg" value="DEBUG (DebugBaseAddr default 0x00000000, DebugSize=0x1000)&#xa;DM register window served by soc_axi_to_dm; halt=DebugBaseAddr+0x800, exception=+0x810." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="240" y="980" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="note_am" value="Notes:&#xa;- soc_top builds the AXI fabric address map from its module parameters (RamBaseAddr / UartBaseAddr / DebugBaseAddr / ClintBaseAddr).&#xa;- The smoke stub branch (EnablePlatform=0) uses local UART0_/DEBUG0_ constants matching tb/test_smoke.py." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="240" y="80" width="540" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
