    <diagram name="Multi-Initiator Architecture (planned)" id="tab8">
        <mxGraphModel dx="866" dy="747" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t8_title" value="Multi-Initiator Architecture (planned endpoint - not today&#39;s wiring)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="75" y="20" width="1400" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t8_legend" value="Solid = current baseline (the axi_xbar replaced the former soc_axi_arbiter + soc_axi_demux).&#xa;Dashed = planned additions (direct CPU instr/data mem ports, the iDMA direct mem port, accelerator, APB-wrapped peripherals).&#xa;The accel_socket_if interface already anticipates the dual-port shape: split mem_axi_* (data) and csr_apb_* (control)." style="text;html=1;strokeColor=#999999;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=8;spacingTop=4" parent="1" vertex="1">
                    <mxGeometry x="1535" y="20" width="620" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="t8_cpu_instr" value="CPU instr&#xa;(fabric + planned mem port)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="155" y="120" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_cpu_data" value="CPU data&#xa;(fabric + planned mem port)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="415" y="120" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_dbg_sba" value="Debug SBA&#xa;(fabric port only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="675" y="120" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_udma" value="iDMA (integrated, single-port)&#xa;CSR + data via xbar today;&#xa;direct mem port planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="935" y="120" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_accel" value="Accelerator (planned)&#xa;via accel_socket_if&#xa;CSR (xbar) + data (direct mem port)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;dashed=1" parent="1" vertex="1">
                    <mxGeometry x="1215" y="120" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_xbar" value="System bus: AXI crossbar (axi_xbar)&#xa;Replaced the former soc_axi_arbiter + soc_axi_demux (in place today). Per-target arbitration; multiple outstanding requests can be in flight to different targets concurrently.&#xa;In the end state the xbar exposes only ~2 slave targets: the peripheral subsystem (one APB bus) and an optional RAM-fallback path (mostly used by debug SBA)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;spacingLeft=20;spacingRight=20" parent="1" vertex="1">
                    <mxGeometry x="155" y="300" width="1700" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="t8_axi2apb" value="soc_axi_to_apb&#xa;(single bridge to the APB peripheral subsystem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="1080" y="539" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_axi2mem" value="soc_axi_to_mem&#xa;(RAM-fallback path; mostly serves Debug SBA in the end state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle" parent="1" vertex="1">
                    <mxGeometry x="295" y="540" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_subsys" value="Peripheral subsystem: APB peripheral bus (one bridge, fan-out behind a small APB demux)" style="swimlane;fontSize=13;fontStyle=1;html=1;startSize=36;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#FFFFFF" parent="1" vertex="1">
                    <mxGeometry x="155" y="680" width="1430" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_uart" value="apb_uart&#xa;(current)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle" parent="t8_apb_subsys" vertex="1">
                    <mxGeometry x="40" y="80" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_clint" value="clint (APB wrap)&#xa;planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;dashed=1" parent="t8_apb_subsys" vertex="1">
                    <mxGeometry x="280" y="80" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_dm" value="dm regs (APB wrap)&#xa;planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=middle;dashed=1" parent="t8_apb_subsys" vertex="1">
                    <mxGeometry x="540" y="80" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_accel_csr" value="accel CSR&#xa;planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;dashed=1" parent="t8_apb_subsys" vertex="1">
                    <mxGeometry x="800" y="80" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_future" value="future peripherals&#xa;SPI / I2C / GPIO / timers / ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;dashed=1" parent="t8_apb_subsys" vertex="1">
                    <mxGeometry x="1040" y="80" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="t8_apb_demux_note" value="(small APB demux; each peripheral has its own address window)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2" parent="t8_apb_subsys" vertex="1">
                    <mxGeometry x="40" y="40" width="1500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t8_memss" value="Memory subsystem: soc_mem_ss (banked SRAM with per-bank round-robin arbitration)" style="swimlane;fontSize=13;fontStyle=1;html=1;startSize=36;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#FFFFFF" parent="1" vertex="1">
                    <mxGeometry x="155" y="1020" width="1590" height="540" as="geometry"/>
                </mxCell>
                <mxCell id="t8_ip0" value="64-bit ports:&#xa;xbar RAM read + write engines&#xa;(Debug SBA + fabric RAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle" parent="t8_memss" vertex="1">
                    <mxGeometry x="30" y="60" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t8_ip1" value="64-bit port:&#xa;UART SRAM loader (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;dashed=1" parent="t8_memss" vertex="1">
                    <mxGeometry x="290" y="60" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t8_ip2" value="32-bit port:&#xa;CPU instruction direct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;dashed=1" parent="t8_memss" vertex="1">
                    <mxGeometry x="550" y="60" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t8_ip3" value="32-bit port:&#xa;CPU data direct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;dashed=1" parent="t8_memss" vertex="1">
                    <mxGeometry x="810" y="60" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t8_ip4" value="64-bit ports:&#xa;iDMA read + write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;dashed=1" parent="t8_memss" vertex="1">
                    <mxGeometry x="1070" y="60" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t8_ip5" value="64-bit port:&#xa;Accel data (planned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;dashed=1" parent="t8_memss" vertex="1">
                    <mxGeometry x="1330" y="60" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t8_arb_note" value="per-bank fair round-robin (rr_arb_tree, soc_mem_ss internal; NumPorts32 / NumPorts64 are parameters)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2" parent="t8_memss" vertex="1">
                    <mxGeometry x="30" y="160" width="1540" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="t8_bank0" value="bank[0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle" parent="t8_memss" vertex="1">
                    <mxGeometry x="30" y="220" width="240" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t8_bank1" value="bank[1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle" parent="t8_memss" vertex="1">
                    <mxGeometry x="290" y="220" width="240" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t8_bank2" value="bank[2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle" parent="t8_memss" vertex="1">
                    <mxGeometry x="550" y="220" width="240" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t8_bank3" value="bank[3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle" parent="t8_memss" vertex="1">
                    <mxGeometry x="810" y="220" width="240" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t8_bank_ellipsis" value="...&#xa;(MemNumBanks is&#xa;a parameter,&#xa;default 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;align=center;dashed=1" parent="t8_memss" vertex="1">
                    <mxGeometry x="1070" y="220" width="220" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t8_three_tier_note" value="Why this layered shape?&#xa;&#xa;Memory subsystem (soc_mem_ss): per-bank arbitration. Memory-heavy initiators (CPU instr/data, DMA, accelerators) get dedicated init ports so bank parallelism actually pays off - the bus fabric does not gate memory bandwidth.&#xa;&#xa;System bus (axi_xbar): per-target AXI arbitration. In the end state the xbar exposes only ~2 slave targets: the peripheral subsystem and an optional RAM-fallback path. The xbar is small because most traffic does not need it.&#xa;&#xa;Peripheral subsystem (APB bus): a single APB peripheral bus behind one soc_axi_to_apb bridge. UART, CLINT (wrapped), DM regs (wrapped), accelerator CSR windows, and future SPI/I2C/GPIO/timers all fan out from one APB demux. Adding a new peripheral is &quot;add to the APB subsystem&quot;, not &quot;reconfigure the xbar&quot;.&#xa;&#xa;What grows linearly: arbiters. M arbiters in the xbar for M targets (only a handful in the end state); B arbiters in soc_mem_ss for B banks; the APB subsystem needs no arbitration (peripherals are slaves, they do not initiate). Wires fan out N x B inside soc_mem_ss but synthesis handles that cleanly at this scale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;spacingBottom=8" parent="1" vertex="1">
                    <mxGeometry x="1715" y="580" width="610" height="310" as="geometry"/>
                </mxCell>
