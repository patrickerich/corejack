CAPI=2:

name: corejack:cores:cva6:0.1.0
description: CVA6 RTL and CoreJack adapter used by the CoreJack platform

filesets:
  rtl:
    files:
      - deps/cva6/core/include/rvfi_types.svh : {file_type : user, copyto : rvfi_types.svh}
      - deps/cva6/core/include/cvxif_types.svh : {file_type : user, copyto : cvxif_types.svh}
      # lzc, rr_arb_tree, stream_register, onehot_to_bin, and popcount are
      # provided by the shared corejack:common:deps fileset (the first three for
      # the axi_xbar system crossbar; onehot_to_bin and popcount were later added
      # there for the iDMA integration). Listing them here too would double-define
      # the modules and trip Vivado CRITICAL WARNING [Synth 8-9873]. Keep only the
      # common_cells that the platform fileset does not already supply.
      - deps/common_cells/src/lfsr.sv
      - deps/common_cells/src/exp_backoff.sv
      - deps/common_cells/src/shift_reg.sv
