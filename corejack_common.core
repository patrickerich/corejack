CAPI=2:

name: corejack:common:deps:0.1.0
description: Shared dependency RTL used by the CoreJack platform

filesets:
  pulp_typedef_headers:
    files:
      - deps/apb/include/apb/typedef.svh : {file_type : user, copyto : apb/typedef.svh}
      - deps/apb/include/apb/assign.svh  : {file_type : user, copyto : apb/assign.svh}
      - deps/axi/include/axi/typedef.svh : {file_type : user, copyto : axi/typedef.svh}
      - deps/axi/include/axi/assign.svh  : {file_type : user, copyto : axi/assign.svh}
      - deps/obi/include/obi/typedef.svh : {file_type : user, copyto : obi/typedef.svh}
      - deps/obi/include/obi/assign.svh  : {file_type : user, copyto : obi/assign.svh}
      - deps/register_interface/include/register_interface/typedef.svh : {file_type : user, copyto : register_interface/typedef.svh}
      - deps/register_interface/include/register_interface/assign.svh  : {file_type : user, copyto : register_interface/assign.svh}
      - deps/common_cells/include/common_cells/assertions.svh : {file_type : user, copyto : common_cells/assertions.svh}
      - deps/common_cells/include/common_cells/registers.svh  : {file_type : user, copyto : common_cells/registers.svh}
      - deps/idma/src/include/idma/typedef.svh : {file_type : user, copyto : idma/typedef.svh}
      - deps/idma/src/include/idma/guard.svh   : {file_type : user, copyto : idma/guard.svh}

  pulp_pkg_deps:
    files:
      - deps/common_cells/src/cf_math_pkg.sv
      - deps/apb/src/apb_pkg.sv
      - deps/axi/src/axi_pkg.sv
      - deps/obi/src/obi_pkg.sv
      - deps/riscv-dbg/src/dm_pkg.sv
      - deps/idma/src/idma_pkg.sv
    file_type: systemVerilogSource

  platform_common_rtl:
    files:
      - deps/common_cells/src/delta_counter.sv
      - deps/common_cells/src/counter.sv
      - deps/common_cells/src/sync.sv
      - deps/common_cells/src/rstgen_bypass.sv
      - deps/common_cells/src/rstgen.sv
      - deps/common_cells/src/fifo_v3.sv
      - deps/common_cells/src/spill_register_flushable.sv
      - deps/common_cells/src/spill_register.sv
      - deps/common_cells/src/cdc_4phase.sv
      - deps/common_cells/src/cdc_reset_ctrlr_pkg.sv
      - deps/common_cells/src/cdc_reset_ctrlr.sv
      - deps/common_cells/src/cdc_2phase_clearable.sv
      - deps/tech_cells_generic/src/rtl/tc_clk.sv
      - deps/obi/src/apb_to_obi.sv
      - deps/register_interface/vendor/lowrisc_opentitan/src/prim_subreg_arb.sv
      - deps/register_interface/vendor/lowrisc_opentitan/src/prim_subreg.sv
      - deps/register_interface/src/reg_intf.sv
      - deps/register_interface/src/reg_to_apb.sv
      - deps/register_interface/src/apb_to_reg_v2.sv
      - deps/clint/src/clint_reg_pkg.sv
      - deps/clint/src/clint_reg_top.sv
      - deps/clint/src/clint.sv
    file_type: systemVerilogSource

  platform_uart_rtl:
    files:
      - deps/obi_peripherals/hw/obi_uart/obi_uart_pkg.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart_baudgen.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart_interrupts.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart_modem.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart_register.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart_rx.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart_tx.sv
      - deps/obi_peripherals/hw/obi_uart/obi_uart.sv
      - deps/apb_uart/src/apb_uart_wrap.sv
    file_type: systemVerilogSource

  platform_debug_rtl:
    files:
      - deps/riscv-dbg/debug_rom/debug_rom.sv
      - deps/riscv-dbg/debug_rom/debug_rom_one_scratch.sv
      - deps/riscv-dbg/src/dm_csrs.sv
      - deps/riscv-dbg/src/dm_mem.sv
      - deps/riscv-dbg/src/dm_sba.sv
      - deps/riscv-dbg/src/dm_top.sv
      - deps/riscv-dbg/src/dmi_cdc.sv
      - deps/riscv-dbg/src/dmi_intf.sv
      - deps/riscv-dbg/src/dmi_jtag_tap.sv
      - deps/riscv-dbg/src/dmi_jtag.sv
    file_type: systemVerilogSource

  common_addr_decode_rtl:
    files:
      - deps/common_cells/src/addr_decode_dync.sv
      - deps/common_cells/src/addr_decode.sv
    file_type: systemVerilogSource

  # PULP axi_xbar and its transitive dependencies, used as the CoreJack system
  # crossbar in soc_top (replaces the former soc_axi_arbiter + soc_axi_demux).
  # Ordered leaf-first; relies on axi_pkg, cf_math_pkg, addr_decode, counter,
  # delta_counter, fifo_v3, and spill_register from the filesets above.
  platform_fabric_rtl:
    files:
      - deps/common_cells/src/lzc.sv
      - deps/common_cells/src/rr_arb_tree.sv
      - deps/common_cells/src/stream_register.sv
      - deps/axi/src/axi_id_prepend.sv
      - deps/axi/src/axi_atop_filter.sv
      - deps/axi/src/axi_err_slv.sv
      # axi >= 0.39 splits the demux into a wrapper plus axi_demux_simple.
      - deps/axi/src/axi_demux_simple.sv
      - deps/axi/src/axi_demux.sv
      - deps/axi/src/axi_mux.sv
      # axi >= 0.39 splits the crossbar into an unmuxed core plus a wrapper.
      - deps/axi/src/axi_xbar_unmuxed.sv
      - deps/axi/src/axi_xbar.sv
    file_type: systemVerilogSource

  # PULP iDMA (register frontend + ND midend + AXI4 backend) and its
  # transitive dependencies, used by rtl/platform/soc_idma.sv. Ordered
  # leaf-first; relies on idma_pkg/axi_pkg and the common_cells files from
  # the filesets above.
  platform_idma_rtl:
    files:
      - deps/common_cells/src/onehot_to_bin.sv
      - deps/common_cells/src/popcount.sv
      - deps/common_cells/src/fall_through_register.sv
      - deps/common_cells/src/passthrough_stream_fifo.sv
      - deps/common_cells/src/stream_fifo.sv
      - deps/common_cells/src/stream_fifo_optimal_wrap.sv
      - deps/common_cells/src/stream_fork.sv
      - deps/common_cells/src/id_queue.sv
      - deps/register_interface/vendor/lowrisc_opentitan/src/prim_subreg_ext.sv
      - deps/axi/src/axi_cut.sv
      - deps/axi/src/axi_multicut.sv
      - deps/axi/src/axi_rw_join.sv
      - deps/axi/src/axi_burst_splitter_gran.sv
      - deps/axi/src/axi_burst_splitter.sv
      - deps/idma/src/backend/idma_axi_read.sv
      - deps/idma/src/backend/idma_axi_write.sv
      - deps/idma/src/backend/idma_channel_coupler.sv
      - deps/idma/src/backend/idma_dataflow_element.sv
      - deps/idma/src/backend/idma_error_handler.sv
      - deps/idma/src/backend/idma_legalizer_page_splitter.sv
      - deps/idma/src/backend/idma_legalizer_pow2_splitter.sv
      - deps/idma/target/rtl/idma_legalizer_rw_axi.sv
      - deps/idma/target/rtl/idma_transport_layer_rw_axi.sv
      - deps/idma/target/rtl/idma_backend_rw_axi.sv
      - deps/idma/src/midend/idma_nd_midend.sv
      - deps/idma/src/frontend/idma_transfer_id_gen.sv
      - deps/idma/target/rtl/idma_reg32_3d_reg_pkg.sv
      - deps/idma/target/rtl/idma_reg32_3d_reg_top.sv
      - deps/idma/target/rtl/idma_reg32_3d_top.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - pulp_typedef_headers
      - pulp_pkg_deps
      - platform_common_rtl
      - platform_uart_rtl
      - platform_debug_rtl
      - common_addr_decode_rtl
      - platform_fabric_rtl
      - platform_idma_rtl
