if SOC_COREJACK_RV32

# The PLIC is a second-level controller on machine external interrupt 11;
# level-1 IRQs take ISR table slots 0..11 and PLIC IDs 0..2 follow from 12.
config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 3

config NUM_IRQS
	default 16

# The console UART's interrupt reaches the core through the PLIC; SERV, with
# no external interrupt input, stays polled.
config UART_INTERRUPT_DRIVEN
	default y if PLIC

# Settings a board's defconfig would normally carry. Zephyr reads one defconfig
# per board target and never merges them, so they are defaults here instead of
# a copy per core and board.
config SERIAL
	default y

config CONSOLE
	default y

config UART_CONSOLE
	default y

config MAIN_STACK_SIZE
	default 2048

config LINKER_USE_RELAX
	default n

# The CLINT counts at half the 25 MHz system clock.
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 12500000

config GEN_IRQ_VECTOR_TABLE
	default y

config ROM_START_OFFSET
	default 0x80 if !SOC_COREJACK_CV32E40S

endif
