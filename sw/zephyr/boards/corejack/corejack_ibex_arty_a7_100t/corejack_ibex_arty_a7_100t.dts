/dts-v1/;

#include <corejack/corejack_ibex.dtsi>

/ {
	model = "CoreJack Ibex on Arty A7-100T";
	compatible = "corejack,corejack-ibex-arty-a7-100t";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,sram = &sram0;
	};
};

/*
 * The Artix-7 100T block-RAM budget caps the shared SRAM at 256 KiB (see
 * cfg/boards/arty_a7_100t.yaml: memory.ram_bytes). Override the 1 MiB AXKU5
 * regions from corejack_rv32_common.dtsi to fit: 192 KiB executable (flash) +
 * 64 KiB writable (sram), contiguous within 0x80000000-0x8003ffff. Both are
 * physically SRAM and loaded together over the debug SBA path.
 */
&flash0 {
	reg = <0x80000000 0x00030000>;
};

&sram0 {
	reg = <0x80030000 0x00010000>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	clock-frequency = <25000000>;
};
